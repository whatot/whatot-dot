{
  "cli_default_open_behavior": "existing_window",
  "base_keymap": "VSCode",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "auto_install_extensions": {
    "github-theme": true,
    "material-icon-theme": true
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 13,
  "disable_ai": true,
  "enable_language_server": false,
  "show_completions_on_input": false,
  "show_completion_documentation": false,
  "show_edit_predictions": false,
  "completions": {
    "lsp": false,
    "words": "disabled"
  },
  "semantic_tokens": "off",
  "inlay_hints": {
    "enabled": false
  },
  "use_on_type_format": false,
  "diagnostics_max_severity": "off",
  "diagnostics": {
    "button": false,
    "lsp_pull_diagnostics": {
      "enabled": false
    },
    "inline": {
      "enabled": false
    }
  },
  "scrollbar": {
    "diagnostics": "none"
  },
  "tabs": {
    "show_diagnostics": "off"
  },
  "format_on_save": "on",
  "project_panel": {
    "dock": "left",
    "show_diagnostics": "off"
  },
  "languages": {
    "JSON": {
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"]
        }
      }
    },
    "JSONC": {
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"]
        }
      }
    },
    "Markdown": {
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"]
        }
      }
    },
    "TOML": {
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"]
        }
      }
    },
    "YAML": {
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"]
        }
      }
    }
  },
  "theme": {
    "mode": "dark",
    "light": "GitHub Light",
    "dark": "GitHub Dark"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "ui_font_size": 14,
  "vim_mode": true
}
